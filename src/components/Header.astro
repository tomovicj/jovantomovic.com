---
interface Props {
  current?: 'home' | 'blog' | 'links' | 'contact';
  crumb?: string;
}

const { current, crumb } = Astro.props;

const items = [
  { id: 'home', label: 'home', href: '/' },
  { id: 'blog', label: 'blog', href: '/blog/' },
  { id: 'links', label: 'links', href: '/links/' },
  { id: 'contact', label: 'contact', href: '/contact/' },
] as const;
---

<header>
  <div class:list={['hdr', { 'has-crumb': crumb }]}>
    <a href="/" class="logo">
      <span aria-hidden="true" class="mark">jt</span>
      <span class="name">jovan tomovic{crumb && <span class="crumb"> / {crumb}</span>}</span>
    </a>
    <nav aria-label="Main" class="navbar">
      {
        items.map((item) =>
          item.id === current ? (
            <a href={item.href} aria-current="page" class="current">
              {item.label}
            </a>
          ) : (
            <a href={item.href} class="nav">
              {item.label}
            </a>
          ),
        )
      }
      <button type="button" class="btn theme" data-theme-toggle aria-label="Switch theme">
        <span aria-hidden="true">◐</span><span data-theme-label>theme</span>
      </button>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const effective = () => (root.dataset.theme as 'dark' | 'light' | undefined) ?? (media.matches ? 'dark' : 'light');

  function sync() {
    const theme = effective();
    const next = theme === 'dark' ? 'light' : 'dark';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      btn.setAttribute('aria-label', `Switch to ${next} theme`);
      const label = btn.querySelector('[data-theme-label]');
      if (label) label.textContent = theme;
    });
  }

  document.querySelectorAll('[data-theme-toggle]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const next = effective() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      sync();
    }),
  );
  media.addEventListener('change', sync);
  sync();
</script>

<style>
  header {
    border-bottom: 1px solid var(--line);
  }
  .hdr {
    max-width: 1120px;
    margin: 0 auto;
    padding: 10px 24px;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    text-decoration: none;
    color: var(--fg);
  }
  .mark {
    width: 32px;
    height: 32px;
    border: 1px solid var(--fg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
  }
  .name {
    font-size: 14px;
    font-weight: 500;
  }
  .crumb {
    color: var(--mute);
  }
  .navbar {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 4px;
  }
  .navbar a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    font-size: 14px;
    text-decoration: none;
  }
  .navbar a.current {
    background: var(--fg);
    color: var(--bg);
  }
  .theme {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-left: 8px;
    padding: 0 12px;
    border: 1px solid var(--line2);
    border-radius: 0;
    background: transparent;
    color: var(--fg);
    font-size: 13px;
    cursor: pointer;
  }

  @media (max-width: 760px) {
    .hdr {
      padding: 10px 16px;
      gap: 8px 16px;
    }
    .navbar a {
      padding: 0 8px;
    }
  }
  /* Pages with a "/ section" crumb need the stacked layout a little earlier. */
  @media (max-width: 660px) {
    .hdr.has-crumb {
      flex-direction: column;
      align-items: stretch;
      padding: 6px 16px 0;
      gap: 6px;
    }
    .hdr.has-crumb > .logo {
      align-self: center;
    }
    .hdr.has-crumb .navbar {
      gap: 0;
      margin: 0 -16px;
      padding: 4px 16px 4px 8px;
      border-top: 1px solid var(--line);
    }
    .hdr.has-crumb .navbar a {
      padding: 0 8px;
      font-size: 13px;
    }
    .hdr.has-crumb .theme {
      margin-left: auto;
      padding: 0 10px;
      font-size: 12px;
    }
  }
  @media (max-width: 580px) {
    .hdr {
      flex-direction: column;
      align-items: stretch;
      padding: 6px 16px 0;
      gap: 6px;
    }
    .hdr > .logo {
      align-self: center;
    }
    .navbar {
      gap: 0;
      margin: 0 -16px;
      padding: 4px 16px 4px 8px;
      border-top: 1px solid var(--line);
    }
    .navbar a {
      padding: 0 8px;
      font-size: 13px;
    }
    .theme {
      margin-left: auto;
      padding: 0 10px;
      font-size: 12px;
    }
  }
  @media (max-width: 360px) {
    .navbar a {
      padding: 0 5px;
      font-size: 12px;
    }
  }
</style>
