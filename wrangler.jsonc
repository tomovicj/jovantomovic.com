{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jovantomovic",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only /api/* reaches the Worker; every other path is served straight from dist/.
    "run_worker_first": ["/api/*"]
  },
  // Sends contact-form messages. On the Free plan the recipient (CONTACT_TO secret)
  // must be a verified Email Routing destination address.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "CONTACT_FROM": "contact@jovantomovic.com"
  },
  // Routes rather than custom domains: the zone's existing proxied DNS records for the apex and www
  // stay in place (the wildcard and links.* CNAMEs point at the apex), and the Worker answers every
  // request on these hostnames, so their origin is never contacted.
  // Keep jovantomovic.jovantomovic5.workers.dev and per-version preview URLs (Workers Builds branch previews).
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "jovantomovic.com/*", "zone_name": "jovantomovic.com" },
    { "pattern": "www.jovantomovic.com/*", "zone_name": "jovantomovic.com" }
  ],
  "observability": { "enabled": true }
}
