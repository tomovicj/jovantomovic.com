{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jovantomovic",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only /api/* reaches the Worker; every other path is served straight from dist/.
    "run_worker_first": ["/api/*"]
  },
  // Sends contact-form messages. On the Free plan the recipient (CONTACT_TO secret)
  // must be a verified Email Routing destination address.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "CONTACT_FROM": "contact@jovantomovic.com"
  },
  "observability": { "enabled": true }
}
